<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AutoEverything.Tests</AssemblyName>
    <RootNamespace>AutoEverything.Tests</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 不输出到 Assemblies/，避免污染游戏目录 -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <RimWorldPath>e:\SteamLibrary\steamapps\common\RimWorld</RimWorldPath>
    <HarmonyPath>e:\SteamLibrary\steamapps\workshop\content\294100\2009463077\Current\Assemblies</HarmonyPath>
  </PropertyGroup>

  <!-- CI 模式：复制 NuGet 包 DLL 到输出目录，供 mono 运行时加载 -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主项目依赖 UnityEngine（HarmonyPatches 等），测试运行时需传递加载 -->
    <Reference Condition="'$(CI)' != 'true'" Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CI 模式：UnityEngine 由 Krafs.Rimworld.Ref 传递引用 -->
  </ItemGroup>

  <!-- CI 模式：引用 RimWorld/Harmony NuGet 包（Private=true 复制到输出目录供 mono 加载） -->
  <ItemGroup Condition="'$(CI)' == 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*">
      <Private>true</Private>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.*">
      <Private>true</Private>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 主项目 DLL 复制到测试目录，避免运行时找不到 AutoEverything.dll -->
    <ProjectReference Include="..\..\Source\AutoEverything\AutoEverything.csproj">
      <Private>true</Private>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

</Project>
